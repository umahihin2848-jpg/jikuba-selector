    "development_races": 400,
    "development_runners_all_starters": 6046,
    "selection": "5-fold GroupKFold by race on 2024; selected from rank-only, score-only, rank+score, rank+score+history candidates using top3 log loss/Brier/AUC without using 2025/2026 outcomes.",
    "confirmation_year": 2025,
    "final_oos_year": 2026,
    "target": "finish<=3",
    "race_coherence": "After logistic calibration, apply one common logit shift within each race so probabilities sum to exactly 3.0."
  },
  "features": ["rank_frac", "score_z", "boundary_margin", "hist_frac"],
  "feature_definitions": {
    "rank_frac": "(M3 rank - 0.5) / number of M3 runners",
    "score_z": "within-race z-score of M3 score; lower is stronger",
    "boundary_margin": "4th-best M3 score minus horse M3 score; positive means inside M3 top 3 side of the boundary",
    "hist_frac": "min(max(hist_n,0),5)/5 using M3 strict-prior-history count"
